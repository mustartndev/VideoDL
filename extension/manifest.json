{
    "manifest_version": 3,
    "name": "Local Video Downloader",
    "version": "1.0",
    "description": "Download videos from the current page using a local backend (yt-dlp).",
    "permissions": [
        "activeTab",
        "scripting",
        "downloads",
        "webRequest"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}